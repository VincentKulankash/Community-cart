# OWNER: VINCENT (Scrum Master / Integration)
# INSTRUCTIONS: Copy this file to `.env` and fill in the values.
SECRET_KEY=generate_a_random_string_here
DATABASE_URL=sqlite:///app.db

# Underground catalog (MongoDB Atlas or a local MongoDB server)
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DATABASE=community_cart_underground
UNDERGROUND_DEMO_MODE=true

# Mailtrap (for Offers outbid notifications) - fill in later
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
MAILTRAP_SERVER=live.smtp.mailtrap.io
MAILTRAP_PORT=587
